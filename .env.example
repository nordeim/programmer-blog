# /dev/log — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ─── Database ────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to apps/web/).
DATABASE_PATH=./devlog.db

# ─── Auth (homegrown HMAC — env name kept for compat, see ADR-004 amendment) ──
# 32+ char secret used to sign session cookies and transaction tokens.
# REQUIRED IN PRODUCTION — the app throws at boot if missing/short.
# Optional in dev (falls back to a dev-only constant with a warning).
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Canonical URL of the site.
# In dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ─── Resend (transactional email) ───────────────────────────────────────
# API key from https://resend.com/api-keys
# Dev sandbox: re_test_... (only delivers to your account email)
# Production:  re_...
RESEND_API_KEY=

# The "from" address. Must be on a verified Resend domain in production.
# Dev sandbox: onboarding@resend.dev
# Production:  /dev/log <noreply@devlog.example>
RESEND_FROM=onboarding@resend.dev

# ─── Signed tokens (subscribe confirm / unsubscribe / preferences) ────────
# 32-byte HMAC key for signing transaction tokens (R-62: these tokens are
# keyed by SIGNED_TOKEN_SECRET; session cookies use BETTER_AUTH_SECRET).
# Required in production — missing (or <32 chars) throws at boot (R-61).
# Generate with: openssl rand -hex 32
SIGNED_TOKEN_SECRET=

# ─── Public env vars (exposed to the client) ─────────────────────────────
# The site's canonical URL. Used in RSS, OG tags, email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub repo to show live stars/forks for in the nav pill.
# Default: the mockup's choice.
NEXT_PUBLIC_GITHUB_REPO=tailwindlabs/tailwindcss

# Author email shown in the footer's mailto link.
NEXT_PUBLIC_AUTHOR_EMAIL=hi@devlog.example

# ─── GitHub API fallback values ──────────────────────────────────────────
# Used when the GitHub API is rate-limited or unreachable.
GITHUB_STATS_FALLBACK_STARS=82400
GITHUB_STATS_FALLBACK_FORKS=4180

# ─── Cron jobs (optional) ───────────────────────────────────────────────
# Shared secret for POST /api/cron/* endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Author seeding (R-57, audit C-38) ─────────────────────────────────────
# Password for the seeded author account (author@devlog.example).
# - Dev: optional; falls back to the documented dev-only default
#   'dev-password-12345' (the login-page hint renders in development only, R-37).
# - Production: REQUIRED before `pnpm db:seed` — the seed refuses to create the
#   author account with the public dev default (R-57). `bash start_server.sh`
#   generates a strong random value automatically when this is absent.
DEV_AUTHOR_PASSWORD=
