# /dev/log — Environment Variables (LOCAL EXAMPLE TEMPLATE)
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
#
# R-72 (Pass 7, C-41): this file previously carried production-faithful
# values (64-hex secrets, the real site URL, a filled author password)
# under a tracked ".example" name. It is now a placeholder-only template
# — identical in spirit to .env.example, kept because start_server.sh
# recognizes it as a fallback template. Every value below MUST be
# replaced before use. If a real secret ever lands in a tracked file,
# rotate it on the deployment immediately and purge history.

# ─── Database ────────────────────────────────────────────────────────────
# Absolute path — standalone server.js chdirs to .next/standalone/apps/web, so a
# relative ./devlog.db resolves to the wrong directory (C-36). Always absolute.
DATABASE_PATH=/absolute/path/to/programmer-blog/apps/web/devlog.db

# ─── Auth (homegrown HMAC — env name kept for compat, see ADR-004 amendment) ──
# 32+ char secret used to sign session cookies.
# REQUIRED IN PRODUCTION — the app throws at boot if missing/short.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Canonical URL of the site (your deployment origin, not localhost in prod).
BETTER_AUTH_URL=https://your-domain.example

# ─── Resend (transactional email) ───────────────────────────────────────
# API key from https://resend.com/api-keys
# Dev sandbox: re_test_... (only delivers to your account email)
# Production:  re_...
# Optional — the subscribe flow degrades gracefully without it.
#RESEND_API_KEY=

# The "from" address. Must be on a verified Resend domain in production.
RESEND_FROM=onboarding@resend.dev

# ─── Signed tokens (subscribe confirm / unsubscribe / preferences) ────────
# 32-byte HMAC key for signing transaction tokens (R-62). Required in prod.
# Generate with: openssl rand -hex 32
SIGNED_TOKEN_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ─── Public env vars (exposed to the client) ─────────────────────────────
# The site's canonical URL. Used in RSS, OG tags, email links, robots.txt.
# A localhost value in production warns at boot (R-41).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# GitHub repo to show live stars/forks for in the nav pill.
NEXT_PUBLIC_GITHUB_REPO=tailwindlabs/tailwindcss

# Author email shown in the footer's mailto link.
NEXT_PUBLIC_AUTHOR_EMAIL=hi@devlog.example

# ─── GitHub API fallback values ──────────────────────────────────────────
# Used when the GitHub API is rate-limited or unreachable.
GITHUB_STATS_FALLBACK_STARS=82400
GITHUB_STATS_FALLBACK_FORKS=4180

# ─── Cron jobs (optional) ───────────────────────────────────────────────
# Shared secret for POST /api/cron/* endpoints. Reserved — no cron routes yet.
#CRON_SECRET=

# ─── Author seeding (R-57, audit C-38) ─────────────────────────────────────
# Password for the seeded author account (author@devlog.example).
# - Dev: optional; falls back to the documented dev-only default
#   'dev-password-12345' (the login-page hint renders in development only, R-37).
# - Production: REQUIRED before `pnpm db:seed` — the seed refuses to create the
#   author account with the public dev default and requires >= 16 chars (R-92).
#DEV_AUTHOR_PASSWORD=
