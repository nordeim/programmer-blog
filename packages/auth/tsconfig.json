{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@devlog/config/tsconfig/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": null,
    "paths": {
      "@devlog/db": ["../db/src/index.ts"],
      "@devlog/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
