# /dev/log — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# Generated 2026-09-04 — absolute DATABASE_PATH + production-faithful local env (R-47 checklist).

# ─── Database ────────────────────────────────────────────────────────────
# Absolute path — standalone server.js chdirs to .next/standalone/apps/web, so a
# relative ./devlog.db resolves to the wrong directory (C-36). Always absolute.
DATABASE_PATH=/Home1/project/programmer-blog/apps/web/devlog.db

# ─── Auth (homegrown HMAC — env name kept for compat, see ADR-004 amendment) ──
# 32+ char secret used to sign session cookies and transaction tokens.
# REQUIRED IN PRODUCTION — the app throws at boot if missing/short.
# Generated 2026-09-04 with: openssl rand -hex 32 (64 hex chars)
BETTER_AUTH_SECRET=e4141cc07934a76acbce8ed8854109f70b3c9ad584e95003cc862963deaf4f3a

# Canonical URL of the site.
BETTER_AUTH_URL=https://programmer-blog.jesspete.shop

# ─── Resend (transactional email) ───────────────────────────────────────
# API key from https://resend.com/api-keys
# Dev sandbox: re_test_... (only delivers to your account email)
# Production:  re_...
# RESEND_API_KEY not set — optional in dev (degrades gracefully)

# The "from" address. Must be on a verified Resend domain in production.
RESEND_FROM=onboarding@resend.dev

# ─── Signed tokens (subscribe confirm / unsubscribe / preferences) ────────
# 32-byte HMAC key for signing tokens. Generated 2026-09-04 with: openssl rand -hex 32
SIGNED_TOKEN_SECRET=37ece168709597a817b22e93d64558cc6c676cb96f12340e9f97dcbc3c3f6f5b

# ─── Public env vars (exposed to the client) ─────────────────────────────
# Production-faithful: the site's canonical URL. Used in RSS, OG tags, email links, robots.txt.
# A localhost value in production warns at boot (R-41).
NEXT_PUBLIC_SITE_URL=https://programmer-blog.jesspete.shop

# GitHub repo to show live stars/forks for in the nav pill.
NEXT_PUBLIC_GITHUB_REPO=tailwindlabs/tailwindcss

# Author email shown in the footer's mailto link.
NEXT_PUBLIC_AUTHOR_EMAIL=hi@devlog.example

# ─── GitHub API fallback values ──────────────────────────────────────────
# Used when the GitHub API is rate-limited or unreachable.
GITHUB_STATS_FALLBACK_STARS=82400
GITHUB_STATS_FALLBACK_FORKS=4180

# ─── Cron jobs (optional) ───────────────────────────────────────────────
# Shared secret for POST /api/cron/* endpoints.
# CRON_SECRET not set — reserved, no cron routes yet

# ─── Dev-only overrides ──────────────────────────────────────────────────
# Rotated 2026-09-04 — replaces the documented default dev-password-12345 (C-35).
# The login-page hint renders only when NODE_ENV=development (R-37).
DEV_AUTHOR_PASSWORD=kui+QHGu2WIISUH7UIG9bt+zW8sXzyFQ
