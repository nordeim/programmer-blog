{
  "name": "devlog",
  "private": true,
  "version": "1.0.0",
  "description": "/dev/log — Notes from a Programmer's Desk. Enterprise-grade programmer blog built with Next.js 16, React 19, Tailwind v4, Drizzle ORM, Better Auth, and Resend.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "node apps/web/.next/standalone/apps/web/server.js",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @devlog/db db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "db:studio": "turbo run db:studio",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "check": "pnpm check-types && pnpm lint && pnpm test:coverage && pnpm audit --prod && pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "prismjs": "^1.30.0"
    }
  }
}
